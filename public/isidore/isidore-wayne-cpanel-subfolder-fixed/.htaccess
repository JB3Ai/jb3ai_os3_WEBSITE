DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /wayne/isidore/

  # Serve actual JavaScript, CSS, images, PDFs, and directories unchanged.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fall back to the React entry point for client-side routes.
  RewriteRule ^ index.html [L]
</IfModule>
