<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to index.html
  RewriteRule ^index\.html$ - [L]

  # NMS must run as a separate Node.js app; disable static website routing
  RewriteRule ^nms(?:/.*)?$ - [G,L,NC]
  RewriteRule ^wayne/nms(?:/.*)?$ - [G,L,NC]

  # Canonical route alias for static Wayne project exports
  RewriteRule ^isidore$ /isidore/ [R=301,L,NC]

  # /wayne/isidore/ is a separate standalone app with its own .htaccess; do not rewrite it here.
  RewriteRule ^wayne/isidore(?:/.*)?$ - [L]

  # Fallback for deployments serving repository root (no built dist/ published)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^isidore(?:/(.*))?$ /public/isidore/$1 [L]

  # Force SPA handling for demo routes even if legacy demo/ folders exist in the web root
  RewriteRule ^demo(/.*)?$ /index.html [L]

  # Exclude static directories and files from SPA rewriting
  RewriteRule ^(brochures|public|clipboard|kids-goexplore|os3grid|dadchef|Wayne|wayne|isidore)(/.*)?$ - [L]
  RewriteRule \.(pdf|png|jpg|jpeg|gif|css|js|svg|woff|woff2|ttf|eot)$ - [L]

  # Rewrite remaining requests to index.html for SPA routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
